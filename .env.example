# Copy to .env.local (never committed) and fill in. Names only here.

# PayPal REST app (developer.paypal.com → Apps & Credentials). sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox personal account that receives the smoke test's payout
PAYPAL_SANDBOX_CREATOR_EMAIL=

# Where PayPal sends the buyer after approving a saved wallet (default http://localhost:3000)
APP_URL=

# Neon Postgres connection string
DATABASE_URL=

# Gemini API key (not used yet)
GEMINI_API_KEY=

# Ed25519 receipt signing key: PKCS#8 DER, base64 (one line). Generate:
#   node -e 'console.log(require("crypto").generateKeyPairSync("ed25519").privateKey.export({format:"der",type:"pkcs8"}).toString("base64"))'
RECEIPT_SIGNING_KEY=
