# Copy to .env.local (never committed) and fill in. Names only here.

# PayPal REST app (developer.paypal.com → Apps & Credentials). sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox personal account that receives the smoke test's payout
PAYPAL_SANDBOX_CREATOR_EMAIL=

# Where PayPal sends the buyer after approving a saved wallet (default http://localhost:3000)
APP_URL=

# Neon Postgres connection string
DATABASE_URL=

# Gemini API key (Google AI Studio, a NEW project; never Vertex AI or the old Google Cloud project)
GEMINI_API_KEY=

# Ed25519 receipt signing key: PKCS#8 DER, base64 (one line). Generate:
#   node -e 'console.log(require("crypto").generateKeyPairSync("ed25519").privateKey.export({format:"der",type:"pkcs8"}).toString("base64"))'
RECEIPT_SIGNING_KEY=

# Render engine
# Seconds the brand has to accept or reject a render before it is auto-accepted (default 120)
REVIEW_WINDOW_SECONDS=
# stub (default: pre-generated demo images, no cost) | gemini (Gemini API images, within the caps below)
RENDER_PROVIDER=
# Optional model overrides (defaults: gemini-nano-banana-2.1, gemini-3.5-flash-lite, 1K)
GEMINI_IMAGE_MODEL=
GEMINI_FILTER_MODEL=
GEMINI_IMAGE_SIZE=
# AI caps: Gemini images per UTC day (30) and per demo workspace (3); over a cap a labelled demo render stands in
RENDER_CAP_DAILY=
RENDER_CAP_PER_WORKSPACE=
# AI video (Gemini Omni Flash, gemini-omni-1.2-flash): at most VIDEO_CAP_TOTAL (3) ever, then the saved demo clip
VIDEO_CAP_TOTAL=
GEMINI_VIDEO_MODEL=
# Clip length in seconds (3-15, default 4) and how long to wait for it (ms, default 300000)
VIDEO_SECONDS=
VIDEO_TIMEOUT_MS=
# Where the creator reference photo (rohit.jpg) and the demo clip (demo-video.mp4) live (default private/, git-ignored)
PRIVATE_DIR=
# Optional: if set, GET /api/cron/settle requires "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional, sandbox only: a saved sandbox wallet (Vault payment token id) offered as "Use demo wallet"
DEMO_VAULT_ID=
