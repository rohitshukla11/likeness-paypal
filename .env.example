# Copy to .env.local (never committed) and fill in. Names only here.

# PayPal REST app (developer.paypal.com → Apps & Credentials). sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox personal account that receives the smoke test's payout
PAYPAL_SANDBOX_CREATOR_EMAIL=
# (also pays the two synthetic demo creators, Maya Lindqvist and Theo Marlowe: they share this sandbox account)

# Where PayPal sends the buyer after approving a saved wallet (default http://localhost:3000)
APP_URL=

# Neon Postgres connection string
DATABASE_URL=

# Gemini API key (Google AI Studio, a NEW project; never Vertex AI or the old Google Cloud project)
GEMINI_API_KEY=

# Ed25519 receipt signing key: PKCS#8 DER, base64 (one line). Generate:
#   node -e 'console.log(require("crypto").generateKeyPairSync("ed25519").privateKey.export({format:"der",type:"pkcs8"}).toString("base64"))'
RECEIPT_SIGNING_KEY=

# Render engine
# Seconds the brand has to accept or reject a render before it is auto-accepted (default 120)
REVIEW_WINDOW_SECONDS=
# stub (default: pre-generated demo images, no cost) | gemini (Gemini API images, within the caps below)
RENDER_PROVIDER=
# Optional model overrides (defaults: gemini-nano-banana-2.1, gemini-3.5-flash-lite, 1K)
GEMINI_IMAGE_MODEL=
GEMINI_FILTER_MODEL=
GEMINI_IMAGE_SIZE=
# AI caps: Gemini images per UTC day (30) and per demo workspace (3); over a cap a labelled demo render stands in
RENDER_CAP_DAILY=
RENDER_CAP_PER_WORKSPACE=
# AI video (Gemini Omni Flash, gemini-omni-1.2-flash): at most VIDEO_CAP_TOTAL (3) ever, then the saved demo clip
VIDEO_CAP_TOTAL=
GEMINI_VIDEO_MODEL=
# Clip length in seconds (3-15, default 4) and how long to wait for it (ms, default 300000)
VIDEO_SECONDS=
VIDEO_TIMEOUT_MS=
# Where the creator reference photo (rohit.jpg) and the demo clip (demo-video.mp4) live (default private/, git-ignored)
PRIVATE_DIR=
# Optional: if set, GET /api/cron/settle requires "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional, sandbox only: a saved sandbox wallet (Vault payment token id) offered as "Use demo wallet"
DEMO_VAULT_ID=

# C2PA content credentials (TEST certificate): `sh scripts/c2pa-testcert.sh` writes private/c2pa/ (git-ignored),
# or pass the PEMs here (newlines may be escaped as \n). Without a certificate, renders carry no manifest.
C2PA_CERT_PEM=
C2PA_KEY_PEM=

# Creator onboarding (off by default): Google sign-in with a NEW OAuth client in your new Google Cloud project
# (authorized redirect URI: <APP_URL>/auth/google/callback), YouTube verification and a live face check.
FEATURE_CREATOR_ONBOARDING=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64: wraps each creator's photo key. Generate:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
PHOTO_KEK=
# Face match threshold against the channel avatar (0.5); face models dir (default .models, `pnpm face:models`)
FACE_MATCH_THRESHOLD=
FACE_MODELS_DIR=

# Deploy (see docs/DEPLOY.md and render.yaml)
# Public base URL of the deployed app (PayPal return URLs, receipts, C2PA); APP_URL is still read as a fallback
APP_BASE_URL=
# The in-process settle loop: seconds between settle() passes (0 or unset: off; the deploy uses 30)
SETTLE_LOOP_SECONDS=
# From `pnpm paypal:webhook --url <APP_BASE_URL> --confirm`: the webhook id PayPal signs deliveries for
PAYPAL_WEBHOOK_ID=
# Bearer token that enables POST /api/e2e on a deployed server for `pnpm e2e:live` (unset: endpoint off)
E2E_TOKEN=

# Agents (brand chat, creator licence review): model and caps (turns per demo workspace, and per UTC day overall)
AGENT_MODEL=
AGENT_TURNS_PER_WORKSPACE=
AGENT_TURNS_DAILY=
# Compliance: COMPLIANCE=stub skips the Gemini vision check after render; PROMPT_PRECHECK=off skips the prompt check
COMPLIANCE=
PROMPT_PRECHECK=
