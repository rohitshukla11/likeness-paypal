{
  "name": "likeness-paypal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke:paypal": "tsx --env-file-if-exists=.env.local scripts/paypal-smoke.ts",
    "paypal:fresh-token": "tsx --env-file-if-exists=.env.local scripts/paypal-fresh-token.ts",
    "check:agent-toolkit": "tsx --env-file-if-exists=.env.local scripts/agent-toolkit-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --conditions=react-server --test --test-reporter=spec tests/*.test.ts",
    "e2e:engine": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/engine-e2e.ts",
    "face:models": "sh scripts/face-models.sh",
    "ai:once": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ai-render-once.ts",
    "seed:assets": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-assets.ts",
    "paypal:webhook": "tsx --env-file-if-exists=.env.local scripts/paypal-webhook.ts",
    "e2e:live": "tsx --env-file-if-exists=.env.local scripts/e2e-live.ts"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "0.9.9",
    "@google/genai": "2.31.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@neondatabase/serverless": "1.2.0",
    "@paypal/agent-toolkit": "1.11.0",
    "ai": "4.3.19",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "22.x"
  }
}
